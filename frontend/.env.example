NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_USE_MOCKS=false

# Stack360 (BFF server-only — NUNCA prefixar com NEXT_PUBLIC_, a key não pode
# chegar ao bundle do browser). O proxy em src/app/api/stack360/* injeta isso.
STACK360_API_BASE_URL=https://stack360.mesquitagrupo.com.br
STACK360_API_KEY=st_...

# Key com scope "admin" (bootstrap via CLI: create-api-key --scopes admin) —
# usada só pelas rotas de gestão (/settings/api-keys). Nunca chega ao browser.
STACK360_ADMIN_API_KEY=st_...

# Login do dashboard (protege TODAS as rotas via src/middleware.ts).
ADMIN_USERNAME=admin
# Hash bcrypt (NUNCA a senha em texto puro). Gere com:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'suaSenhaForte'
# e copie só a parte depois do ":" (ex.: $2y$10$...).
ADMIN_PASSWORD_HASH=$2y$10$...
# Assina o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=...
