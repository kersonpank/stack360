# Copie para deploy/.env.prod e preencha. NUNCA committar deploy/.env.prod.
# Suba com:
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build

# ─────────────────────────── Postgres ───────────────────────────
POSTGRES_PASSWORD=troque-por-uma-senha-longa-aleatoria

# ─────────────────────────── Stack360 API ───────────────────────
# É o MESMO banco em 3 variáveis:
#  - STACK360_DATABASE_URL  -> usada pela aplicação (config Stack360)
#  - DATABASE_URL / NORMALIZER_DATABASE_URL -> usadas pelo Alembic (config legada)
# Host = "db" (nome do serviço no compose).
STACK360_DATABASE_URL=postgresql+psycopg2://stack360:troque-por-uma-senha-longa-aleatoria@db:5432/stack360
DATABASE_URL=postgresql+psycopg2://stack360:troque-por-uma-senha-longa-aleatoria@db:5432/stack360
NORMALIZER_DATABASE_URL=postgresql+psycopg2://stack360:troque-por-uma-senha-longa-aleatoria@db:5432/stack360

# Origens do navegador autorizadas a chamar a API (CSV). Vazio = nenhuma.
# Ex.: o frontend em produção.
STACK360_CORS_ORIGINS=https://app.seudominio.com

# Chave-mestra p/ cifrar webhook secret at-rest (AES-GCM). Opcional.
# Gere: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STACK360_WEBHOOK_SECRET_KEY=

# Revalidação de API key nas sessões MCP (segundos). 0 = revalida toda chamada.
STACK360_MCP_AUTH_TTL=30

# Workers uvicorn
WEB_CONCURRENCY=2

# ─────────────────────── Caddy / HTTPS / gate ──────────────────
# Domínio que aponta (DNS A) para a VPS. Use ":80" para testar sem domínio.
DOMAIN=api.seudominio.com
ACME_EMAIL=voce@seudominio.com

# Basic Auth só para /docs, /redoc e /openapi.json.
BASIC_AUTH_USER=admin
# Gere o hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'suaSenhaForte'
BASIC_AUTH_HASH=
